<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krypton.Toolkit.Suite.Extended.Outlook.Grid" Version="105.26.4.110" />
    <PackageReference Include="Krypton.Toolkit.Suite.Extended.TreeGridView" Version="105.26.4.110" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.9" />
    <PackageReference Include="OpenAI" Version="2.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="CommandEngineIntegration\CodexExpensa.ExtensionDevHost.CommandEngineIntegration.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Templates\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="CommandEngineIntegration\**\*.cs" />
    <Compile Remove="CommandEngineIntegration.TestHarness\**\*.cs" />
    <Compile Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration\**\*.cs" />
    <Compile Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration.TestHarness\**\*.cs" />

    <EmbeddedResource Remove="CommandEngineIntegration\**\*" />
    <EmbeddedResource Remove="CommandEngineIntegration.TestHarness\**\*" />
    <EmbeddedResource Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration\**\*" />
    <EmbeddedResource Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration.TestHarness\**\*" />

    <None Remove="CommandEngineIntegration\**\*" />
    <None Remove="CommandEngineIntegration.TestHarness\**\*" />
    <None Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration\**\*" />
    <None Remove="CodexExpensa.ExtensionDevHost.CommandEngineIntegration.TestHarness\**\*" />

    <Compile Remove="**\bin\**\*.cs" />
    <Compile Remove="**\obj\**\*.cs" />
    <EmbeddedResource Remove="**\bin\**\*" />
    <EmbeddedResource Remove="**\obj\**\*" />
    <None Remove="**\bin\**\*" />
    <None Remove="**\obj\**\*" />

    <Compile Remove="Extensions\MainForm.Designer.cs" />
    <EmbeddedResource Remove="Extensions\MainForm.resx" />
  </ItemGroup>
</Project>
