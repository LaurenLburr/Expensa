<UserControl
    x:Class="CodexExpensa.ExtensionDevHost.CommandEngineIntegration.Budgets.BudgetTransactionWpfGridControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:budgets="clr-namespace:CodexExpensa.ExtensionDevHost.CommandEngineIntegration.Budgets">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <SolidColorBrush x:Key="ProjectedStatusBackgroundBrush" Color="#DBEAFE" />
        <SolidColorBrush x:Key="OutstandingStatusBackgroundBrush" Color="#FEF3C7" />
        <SolidColorBrush x:Key="ClearedStatusBackgroundBrush" Color="#D1FAE5" />
        <SolidColorBrush x:Key="StatusForegroundBrush" Color="#111827" />

        <Style x:Key="ExpandCollapseButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate
            x:Key="ItemCellTemplate"
            DataType="{x:Type budgets:BudgetTransactionWpfGridRow}">
            <StackPanel Orientation="Horizontal">
                <Button
                    Width="16"
                    Height="16"
                    Margin="0,0,3,0"
                    Click="ToggleButton_Click"
                    Content="{Binding ToggleText}"
                    Style="{StaticResource ExpandCollapseButtonStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Text="{Binding DisplayItem}" />
            </StackPanel>
        </DataTemplate>

        <Style x:Key="BudgetRowStyle" TargetType="DataGridRow">
            <Setter Property="DetailsVisibility" Value="{Binding IsExpanded, Converter={StaticResource BooleanToVisibilityConverter}}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpanded}" Value="False" />
                        <Condition Binding="{Binding RollupStatus}" Value="Outstanding" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource OutstandingStatusBackgroundBrush}" />
                </MultiDataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsExpanded}" Value="False" />
                        <Condition Binding="{Binding RollupStatus}" Value="Cleared" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Background" Value="{DynamicResource ClearedStatusBackgroundBrush}" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionGridStyle" TargetType="DataGrid">
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style x:Key="TransactionRowStyle" TargetType="DataGridRow">
            <Setter Property="Foreground" Value="{DynamicResource StatusForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Projected">
                    <Setter Property="Background" Value="{DynamicResource ProjectedStatusBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Outstanding">
                    <Setter Property="Background" Value="{DynamicResource OutstandingStatusBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cleared">
                    <Setter Property="Background" Value="{DynamicResource ClearedStatusBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TransactionCellStyle" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{DynamicResource StatusForegroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Projected">
                    <Setter Property="Background" Value="{DynamicResource ProjectedStatusBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Outstanding">
                    <Setter Property="Background" Value="{DynamicResource OutstandingStatusBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cleared">
                    <Setter Property="Background" Value="{DynamicResource ClearedStatusBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Border
            x:Name="StatusColorPanel"
            DockPanel.Dock="Bottom"
            Margin="0,4,0,0"
            Padding="8"
            BorderBrush="#FFB8C2CC"
            BorderThickness="1"
            Visibility="Collapsed">
            <Border.RenderTransform>
                <TranslateTransform Y="36" />
            </Border.RenderTransform>
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Text="Status colors" />
                <Button
                    MinWidth="96"
                    Margin="0,0,6,0"
                    Padding="8,3"
                    Background="{DynamicResource ProjectedStatusBackgroundBrush}"
                    Click="StatusColorSwatch_Click"
                    Content="Projected"
                    Tag="ProjectedStatusBackgroundBrush" />
                <Button
                    MinWidth="104"
                    Margin="0,0,6,0"
                    Padding="8,3"
                    Background="{DynamicResource OutstandingStatusBackgroundBrush}"
                    Click="StatusColorSwatch_Click"
                    Content="Outstanding"
                    Tag="OutstandingStatusBackgroundBrush" />
                <Button
                    MinWidth="80"
                    Margin="0,0,6,0"
                    Padding="8,3"
                    Background="{DynamicResource ClearedStatusBackgroundBrush}"
                    Click="StatusColorSwatch_Click"
                    Content="Cleared"
                    Tag="ClearedStatusBackgroundBrush" />
                <Button
                    Padding="8,3"
                    Click="ToggleStatusColorPanel_Click"
                    Content="Close" />
            </StackPanel>
        </Border>

        <Button
            DockPanel.Dock="Bottom"
            Margin="0,4,0,0"
            HorizontalAlignment="Left"
            Padding="8,3"
            Click="ToggleStatusColorPanel_Click"
            Content="Status colors..." />

        <DataGrid
            x:Name="BudgetRowsDataGrid"
            AutoGenerateColumns="False"
            CanUserAddRows="False"
            CanUserDeleteRows="False"
            CanUserReorderColumns="False"
            CanUserSortColumns="False"
            HeadersVisibility="Column"
            IsReadOnly="True"
            MouseDoubleClick="Grid_MouseDoubleClick"
            PreviewMouseRightButtonDown="Grid_PreviewMouseRightButtonDown"
            RowStyle="{StaticResource BudgetRowStyle}"
            SelectionMode="Single"
            SelectionUnit="FullRow">
            <DataGrid.RowDetailsTemplate>
                <DataTemplate DataType="{x:Type budgets:BudgetTransactionWpfGridRow}">
                    <DockPanel
                        Margin="19,0,0,6"
                        Visibility="{Binding HasTransactions, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <DataGrid
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            ItemsSource="{Binding Transactions}"
                            CellStyle="{StaticResource TransactionCellStyle}"
                            MouseDoubleClick="TransactionGrid_MouseDoubleClick"
                            PreviewMouseRightButtonDown="TransactionGrid_PreviewMouseRightButtonDown"
                            RowStyle="{StaticResource TransactionRowStyle}"
                            SelectionMode="Single"
                            SelectionUnit="FullRow"
                            Style="{StaticResource TransactionGridStyle}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Item" Binding="{Binding DisplayItem}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Payee" Binding="{Binding Values[Payee]}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="Status">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type budgets:BudgetTransactionWpfGridRow}">
                                            <TextBlock
                                                MinWidth="110"
                                                Padding="4,0"
                                                VerticalAlignment="Center"
                                                Text="{Binding Status}">
                                                <TextBlock.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem
                                                            Click="StatusContextMenuItem_Click"
                                                            Header="Projected"
                                                            Tag="Projected" />
                                                        <MenuItem
                                                            Click="StatusContextMenuItem_Click"
                                                            Header="Outstanding"
                                                            Tag="Outstanding" />
                                                        <MenuItem
                                                            Click="StatusContextMenuItem_Click"
                                                            Header="Cleared"
                                                            Tag="Cleared" />
                                                    </ContextMenu>
                                                </TextBlock.ContextMenu>
                                            </TextBlock>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Values[Amount]}" IsReadOnly="True" />
                                <DataGridTextColumn Header="StartDate" Binding="{Binding Values[StartDate]}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Account" Binding="{Binding Values[Account]}" IsReadOnly="True" />
                                <DataGridTextColumn Header="ConfirmationNum" Binding="{Binding Values[ConfirmationNum]}" IsReadOnly="True" />
                                <DataGridTextColumn Header="Note" Binding="{Binding Values[Note]}" IsReadOnly="True" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </DataTemplate>
            </DataGrid.RowDetailsTemplate>
        </DataGrid>
    </DockPanel>
</UserControl>
